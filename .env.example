# TR-OS Environment Configuration
# Copy to .env and fill in real values

# DeepSeek API key (required for mission execution)
DEEPSEEK_API_KEY=sk-your-key-here

# Atlas Flight Booking authorization
ATLAS_AUTH_TOKEN=your-atlas-token

# --- Environment ---
TR_OS_ENVIRONMENT=development
# Options: development, testing, production

# --- API server ---
TR_OS_API_HOST=0.0.0.0
TR_OS_API_PORT=8000
TR_OS_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
TR_OS_LOG_LEVEL=INFO

# --- Authentication ---
TR_OS_AUTH_MODE=dev
# Options: dev (X-Dev-User-Id header), bearer (HMAC-SHA256 token)
TR_OS_AUTH_SECRET=
# Required in production with bearer mode

# --- Rate limiting ---
TR_OS_RATE_LIMIT_RPM=60
TR_OS_MAX_BODY_SIZE=1048576

# --- Execution ---
TR_OS_MAX_WORKERS=4
TR_OS_MAX_CONCURRENT_MISSIONS=10
TR_OS_MISSION_TIMEOUT_SEC=120
TR_OS_IDEMPOTENCY_TTL_SEC=3600

# --- SSE ---
TR_OS_SSE_HEARTBEAT_SEC=15
TR_OS_SSE_MAX_CONNECTION_SEC=600

# --- Mission constraints ---
TR_OS_MAX_RECOVERY_ATTEMPTS=2

# --- Database (Phase 10) ---
TR_OS_DATABASE_URL=data/tros.db

# --- Build metadata (Phase 10, injected by CI) ---
TR_OS_BUILD_VERSION=0.10.0
TR_OS_COMMIT_SHA=
TR_OS_BUILD_TIME=

# --- Worker configuration (Phase 10) ---
TR_OS_WORKER_COUNT=1
# Must remain 1 in production (in-process state, SSE, cancellation)

# --- Atlas authentication (Phase 10) ---
TR_OS_ATLAS_AUTH_TOKEN=
# Required in production for Atlas API access
